{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://taxoryn-backend.onrender.com/api/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://taxoryn-backend.onrender.com/actuator/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
