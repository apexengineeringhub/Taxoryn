# ==============================================================================
# Taxoryn Platform Environment Configuration Template (.env.example)
#
# Copy this file to .env for local overrides or configure these variables in
# your cloud/container hosting provider (Render, AWS, GCP, Azure, Vercel, Docker).
#
# NEVER commit real secrets or production credentials to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Active Profile
# Options: dev (local development), demo (staging/demo), prod (production)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8088
TAXORYN_RESET_PASSWORD_URL=http://localhost:5173/reset-password
TAXORYN_LOGIN_URL=http://localhost:5173/login
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://taxoryn.com,https://app.taxoryn.com

# ------------------------------------------------------------------------------
# 3. Database Credentials
# Required in production: DB_URL, DB_USERNAME, DB_PASSWORD
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/taxoryn_db
DB_USERNAME=taxoryn_user
DB_PASSWORD=your_secure_db_password_here
# Alternative Spring Datasource names supported:
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# ------------------------------------------------------------------------------
# 4. JWT Authentication & Token Security
# Required in production: 256-bit+ (32 bytes) cryptographically random secret
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=your_256_bit_cryptographic_jwt_signing_secret_here
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=taxoryn-platform

# ------------------------------------------------------------------------------
# 5. Storage Configuration (Local or Cloud S3 / Cloudflare R2 / AWS S3)
# Options for STORAGE_PROVIDER: LOCAL (dev/test only), S3 (MANDATORY in production)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_BASE_DIR=./data/documents
# Cloudflare R2 / AWS S3 Configuration (required in production):
STORAGE_BUCKET=taxoryn-documents
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key_id
STORAGE_SECRET_KEY=your_r2_secret_access_key
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Alternative Cloudflare R2 / S3 aliases also supported:
# R2_BUCKET=taxoryn-documents
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_ACCOUNT_ID=
# STORAGE_PRESIGNED_URL_DURATION_MINUTES=15


# ------------------------------------------------------------------------------
# 6. Email Service (SMTP, Resend, or Brevo)
# ------------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_PROVIDER=LOG
MAIL_FROM_EMAIL=notifications@taxoryn.com
MAIL_FROM_NAME=Taxoryn
# SMTP Configuration:
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Cloud Email API Keys (if using RESEND or BREVO provider):
RESEND_API_KEY=
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 7. WhatsApp Business API (Meta Cloud)
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=LOG
WHATSAPP_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 8. Initial Production SuperAdmin Bootstrap (Optional, One-Time Execution)
# ------------------------------------------------------------------------------
TAXORYN_BOOTSTRAP_ADMIN_EMAIL=
TAXORYN_BOOTSTRAP_ADMIN_PASSWORD=
TAXORYN_BOOTSTRAP_ADMIN_PHONE=
TAXORYN_BOOTSTRAP_ADMIN_FIRST_NAME=
TAXORYN_BOOTSTRAP_ADMIN_LAST_NAME=
