# ==============================================================================
# Taxoryn Environment Variables & Secrets Template
# Instructions:
# 1. Copy this file to `.env` (in root) or create `src/main/resources/application-local.yml`
# 2. Both `.env` and `application-local.yml` are ignored in .gitignore and will never be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# WhatsApp Integration (Meta Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=META
WHATSAPP_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=1345984618587263
WHATSAPP_BUSINESS_ACCOUNT_ID=1430976512178761
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_meta_access_token_here
TAXORYN_LOGIN_URL=http://localhost:5173/login

# ------------------------------------------------------------------------------
# Database & Platform Security (Optional Overrides)
# ------------------------------------------------------------------------------
